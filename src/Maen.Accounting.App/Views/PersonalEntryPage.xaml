<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Maen.Accounting.App.Views.PersonalEntryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Maen.Accounting.App"
    Title="{local:Tr Key=T110}"
    BackgroundColor="{StaticResource AppBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="18,20,18,32" Spacing="16" MaximumWidthRequest="680" HorizontalOptions="Center">
            <Border Style="{StaticResource HeroCard}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{local:Tr Key=T110}" TextColor="White" FontSize="25" FontAttributes="Bold" />
                    <Label Text="{local:Tr Key=T154}" TextColor="#D7FAE8" FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{local:Tr Key=T021}" FontAttributes="Bold" />
                    <DatePicker Date="{Binding EntryDate}" />

                    <Label Text="{local:Tr Key=T152}" FontAttributes="Bold" Margin="0,6,0,0" />
                    <Picker ItemsSource="{Binding MovementTypes}" SelectedItem="{Binding SelectedMovementType}" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10" Margin="0,2,0,0">
                        <Button Grid.Row="0" Text="{local:Tr Key=T332}" Clicked="OnSalaryQuickClicked" BackgroundColor="#DDF7EA" TextColor="#087A55" CornerRadius="14" />
                        <Button Grid.Row="0" Grid.Column="1" Text="{local:Tr Key=T334}" Clicked="OnDailyIncomeQuickClicked" BackgroundColor="#E1ECFF" TextColor="#1D4ED8" CornerRadius="14" />
                        <Button Grid.Row="1" Grid.ColumnSpan="2" Text="{local:Tr Key=T145}" Clicked="OnPurchaseQuickClicked" BackgroundColor="#FFF1D6" TextColor="#8A5A00" CornerRadius="14" />
                        <Button Grid.Row="2" Text="{local:Tr Key=T364}" Clicked="OnBankDepositQuickClicked" BackgroundColor="#E5F4FF" TextColor="#075985" CornerRadius="14" />
                        <Button Grid.Row="2" Grid.Column="1" Text="{local:Tr Key=T365}" Clicked="OnBankWithdrawalQuickClicked" BackgroundColor="#FFE5E5" TextColor="#B42318" CornerRadius="14" />
                    </Grid>

                    <Label Text="{local:Tr Key=T153}" FontAttributes="Bold" Margin="0,6,0,0" />
                    <Picker ItemsSource="{Binding Directions}" SelectedItem="{Binding SelectedDirection}" />

                    <Label Text="{local:Tr Key=T149}" FontAttributes="Bold" Margin="0,6,0,0" />
                    <Entry Text="{Binding AmountInput}" Keyboard="Numeric" Placeholder="0" FontSize="22" ClearButtonVisibility="WhileEditing" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,6,0,0">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{local:Tr Key=T345}" FontAttributes="Bold" />
                            <Entry Text="{Binding CategoryInput}" Placeholder="{local:Tr Key=T349}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{local:Tr Key=T346}" FontAttributes="Bold" />
                            <Entry Text="{Binding WalletInput}" Placeholder="{local:Tr Key=T348}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="{local:Tr Key=T347}" FontAttributes="Bold" Margin="0,6,0,0" />
                    <Entry Text="{Binding CounterpartyInput}" Placeholder="{local:Tr Key=T350}" />

                    <Label Text="{local:Tr Key=T093}" FontAttributes="Bold" Margin="0,6,0,0" />
                    <Editor Text="{Binding NotesInput}" AutoSize="TextChanges" MinimumHeightRequest="90" />

                    <Label Text="{local:Tr Key=T721}" FontAttributes="Bold" Margin="0,6,0,0" IsVisible="{Binding HasAttachment, Converter={x:Static local:InverseBooleanConverter.Instance}}" />
                    <Button Text="{local:Tr Key=T722}" Clicked="OnAttachPhotoClicked" BackgroundColor="#E1ECFF" TextColor="#1D4ED8" CornerRadius="14" IsVisible="{Binding HasAttachment, Converter={x:Static local:InverseBooleanConverter.Instance}}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding HasAttachment}">
                        <Border HeightRequest="140" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Image Source="{Binding AttachmentImage}" Aspect="AspectFit" HeightRequest="140" />
                    </Border>
                        <Button Grid.Column="1" Text="{local:Tr Key=T723}" Clicked="OnRemoveAttachmentClicked" Style="{StaticResource DangerButton}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#EAF8F2" StrokeThickness="0" Padding="18">
                <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding DirectionSummaryText}" TextColor="#087A55" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding PreviewNetText}" TextColor="#087A55" FontSize="25" FontAttributes="Bold" />
                </Grid>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />
            <Button Text="{local:Tr Key=T062}" Clicked="OnSaveClicked" Style="{StaticResource PrimaryButton}" HeightRequest="56" />
            <Label Text="{Binding StatusMessage}" Style="{StaticResource MutedLabel}" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
