<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Maen.Accounting.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Maen.Accounting.App"
    Title="{local:Tr Key=T018}">
    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14" MaximumWidthRequest="760" HorizontalOptions="Center">
            <Label Text="{local:Tr Key=T019}" Style="{StaticResource TitleLabel}" />

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{local:Tr Key=T023}" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding UserEmail}" FlowDirection="LeftToRight" HorizontalTextAlignment="End" />
                    <Label Text="{Binding AccountModeText}" Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{local:Tr Key=T123}" Style="{StaticResource SectionTitle}" />
                    <Label Text="{local:Tr Key=T124}" Style="{StaticResource MutedLabel}" />
                    <Button Text="{local:Tr Key=T125}" Style="{StaticResource SecondaryButton}" Clicked="OnChooseExperienceClicked" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{local:Tr Key=T322}" Style="{StaticResource SectionTitle}" />
                    <Label Text="{local:Tr Key=T323}" Style="{StaticResource MutedLabel}" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="{local:Tr Key=T325}" Style="{StaticResource SecondaryButton}" HorizontalOptions="FillAndExpand" Clicked="OnArabicLanguageClicked" />
                        <Button Text="{local:Tr Key=T326}" Style="{StaticResource SecondaryButton}" HorizontalOptions="FillAndExpand" Clicked="OnEnglishLanguageClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{local:Tr Key=T045}" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding SyncStatus}" Style="{StaticResource MutedLabel}" />
                    <Button Text="{local:Tr Key=T091}" IsVisible="{Binding IsCloudAccount}" Clicked="OnSyncClicked" />
                    <Label Text="{local:Tr Key=T046}" Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{local:Tr Key=T049}" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding BackupStatus}" Style="{StaticResource MutedLabel}" />
                    <Button Text="{local:Tr Key=T057}" Style="{StaticResource SecondaryButton}" Clicked="OnExportClicked" />
                    <Button Text="{local:Tr Key=T017}" Style="{StaticResource SecondaryButton}" Clicked="OnImportClicked" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{local:Tr Key=T028}" Style="{StaticResource SectionTitle}" />
                    <Label Text="{local:Tr Key=T083}" Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" />
            <Button Text="{local:Tr Key=T055}" Style="{StaticResource DangerButton}" Clicked="OnSignOutClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
