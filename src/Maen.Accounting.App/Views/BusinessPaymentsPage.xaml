<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Maen.Accounting.App.Views.BusinessPaymentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Maen.Accounting.App"
    xmlns:views="clr-namespace:Maen.Accounting.App.Views">
    <Grid RowDefinitions="Auto,*" Padding="18" MaximumWidthRequest="1100" HorizontalOptions="Center">
        <views:BrandHeaderView
            Eyebrow="Maen Accounting"
            Title="{local:Tr Key=T065}"
            Subtitle="{local:Tr Key=T038}"
            Status="{Binding StatusMessage}"
            HasStatus="True" />

        <ScrollView Grid.Row="1" Margin="0,14,0,0">
            <VerticalStackLayout Spacing="14">
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{local:Tr Key=T065}" Style="{StaticResource SectionTitle}" />
                            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Picker Title="{local:Tr Key=T100}" ItemsSource="{Binding PaymentTypes}" SelectedItem="{Binding SelectedPaymentType}" ItemDisplayBinding="{Binding Label}" />
                            <Picker Grid.Column="1" Title="{local:Tr Key=T041}" ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedPaymentContact}" ItemDisplayBinding="{Binding DisplayText}" />
                        </Grid>
                        <Picker Title="{local:Tr Key=T373}" ItemsSource="{Binding PaymentAccounts}" SelectedItem="{Binding SelectedPaymentAccount}" ItemDisplayBinding="{Binding DisplayText}" />
                        <DatePicker Date="{Binding PaymentDate}" Format="yyyy-MM-dd" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Entry Text="{Binding PaymentNumberInput}" Placeholder="{local:Tr Key=T304}" />
                            <Entry Grid.Column="1" Text="{Binding PaymentAmountInput}" Placeholder="{local:Tr Key=T297}" Keyboard="Numeric" />
                        </Grid>
                        <Button Text="{local:Tr Key=T063}" Style="{StaticResource AccentButton}" Clicked="OnSavePaymentClicked" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{local:Tr Key=T487}" Style="{StaticResource MetricCaption}" />
                        <Entry Text="{Binding PaymentSearchText}" Placeholder="{local:Tr Key=T065}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{local:Tr Key=T065}" Style="{StaticResource SectionTitle}" />
                <CollectionView ItemsSource="{Binding FilteredPayments}" HeightRequest="420" EmptyView="{local:Tr Key=T082}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ListItemBorder}" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding Number}" FontAttributes="Bold" />
                                        <Label Text="{Binding ContactText}" Style="{StaticResource MutedLabel}" />
                                        <Label Text="{Binding AccountText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                        <Label Text="{Binding DateText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="3">
                                        <Label Text="{Binding AmountText}" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                                        <Label Text="{Binding TypeText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                        <Button Text="{local:Tr Key=T490}" FontSize="11" TextColor="{StaticResource Danger}" Background="Transparent" Clicked="OnDeletePaymentClicked" CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
