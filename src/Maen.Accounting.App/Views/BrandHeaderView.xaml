<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Maen.Accounting.App.Views.BrandHeaderView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Border Style="{StaticResource HeroCard}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                <Label Text="{Binding Eyebrow, Source={x:Reference Root}}" TextColor="{StaticResource AccentLight}" FontSize="13" />
                <Label Text="{Binding Title, Source={x:Reference Root}}" TextColor="White" FontSize="27" FontAttributes="Bold" />
                <Label Text="{Binding Subtitle, Source={x:Reference Root}}" TextColor="{StaticResource AccentLight}" FontSize="13" LineBreakMode="WordWrap" />
                <Border IsVisible="{Binding HasBadge, Source={x:Reference Root}}" BackgroundColor="#2D4962" StrokeThickness="0" Padding="10,5" HorizontalOptions="Start" Margin="0,4,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label Text="{Binding Badge, Source={x:Reference Root}}" TextColor="{StaticResource AccentLight}" FontSize="12" FontAttributes="Bold" />
                </Border>
                <Border IsVisible="{Binding HasStatus, Source={x:Reference Root}}" BackgroundColor="#18324A" Stroke="#486A83" StrokeThickness="1" Padding="10,5" HorizontalOptions="Start" Margin="0,2,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label Text="{Binding Status, Source={x:Reference Root}}" TextColor="White" FontSize="11" LineBreakMode="TailTruncation" />
                </Border>
            </VerticalStackLayout>
            <Border Grid.Column="1" BackgroundColor="White" WidthRequest="72" HeightRequest="72" StrokeThickness="0" VerticalOptions="Center" Padding="3">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <Image Source="maen_logo.png" Aspect="AspectFit" />
            </Border>
        </Grid>
    </Border>
</ContentView>
