<ContentPage
    x:Class="Maen.Accounting.App.Views.PersonalDashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Maen.Accounting.App"
    xmlns:views="clr-namespace:Maen.Accounting.App.Views"
    Title="{local:Tr Key=T032}"
    BackgroundColor="{StaticResource AppBackground}">
    <ScrollView>
            <VerticalStackLayout Padding="18,20,18,32" Spacing="16" MaximumWidthRequest="760" HorizontalOptions="Center">
                <views:BrandHeaderView
                    Eyebrow="{local:Tr Key=T106}"
                    Title="{local:Tr Key=T105}"
                    Subtitle="{local:Tr Key=T107}"
                    Badge="{Binding CurrentMonthNetText}"
                    HasBadge="True"
                    Status="{Binding SyncStatus}"
                    HasStatus="True" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Style="{StaticResource MetricCard}">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{local:Tr Key=T108}" Style="{StaticResource MetricCaption}" />
                            <Label Text="{Binding CurrentMonthSalesText}" TextColor="#137A53" FontSize="22" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{local:Tr Key=T109}" Style="{StaticResource MetricCaption}" />
                            <Label Text="{Binding CurrentMonthExpensesText}" TextColor="#C2413A" FontSize="22" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{local:Tr Key=T353}" FontSize="18" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                            <Border Style="{StaticResource MetricCard}">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{local:Tr Key=T338}" Style="{StaticResource MetricCaption}" />
                                    <Label Text="{Binding CurrentMonthIncomeText}" TextColor="#137A53" FontSize="20" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{local:Tr Key=T337}" Style="{StaticResource MetricCaption}" />
                                    <Label Text="{Binding CurrentMonthAvailableBalanceText}" TextColor="{StaticResource PrimaryDark}" FontSize="20" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource MetricCard}">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{local:Tr Key=T339}" Style="{StaticResource MetricCaption}" />
                                    <Label Text="{Binding CurrentMonthSalaryText}" TextColor="#137A53" FontSize="20" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricCard}">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{local:Tr Key=T340}" Style="{StaticResource MetricCaption}" />
                                    <Label Text="{Binding CurrentMonthFreelanceText}" TextColor="#137A53" FontSize="20" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{local:Tr Key=T341}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding CurrentMonthPurchasesText}" TextColor="#C2413A" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{local:Tr Key=T342}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding CurrentMonthWithdrawalsText}" TextColor="#C2413A" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="3">
                                <Label Text="{local:Tr Key=T343}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding CurrentMonthDebtPaymentsText}" TextColor="#C2413A" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="{local:Tr Key=T351}" Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{local:Tr Key=T363}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{local:Tr Key=T369}" Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding BankBalanceText}" TextColor="#075985" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{local:Tr Key=T366}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding BankBalanceText}" TextColor="#075985" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{local:Tr Key=T367}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding CurrentMonthBankDepositsText}" TextColor="#137A53" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="3">
                                <Label Text="{local:Tr Key=T368}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding CurrentMonthBankWithdrawalsText}" TextColor="#C2413A" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding HasAgingExposure}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{local:Tr Key=T544}" FontSize="17" FontAttributes="Bold" />
                                <Label Text="{local:Tr Key=T545}" Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding ReceivablesAgingTotalText}" TextColor="#075985" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{local:Tr Key=T546}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding ReceivablesAgingCurrentText}" TextColor="#137A53" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{local:Tr Key=T547}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding ReceivablesAgingOverNinetyText}" TextColor="#C2413A" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="3">
                                <Label Text="{local:Tr Key=T548}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding PayablesAgingTotalText}" TextColor="#A84B2E" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding HasPlan}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{local:Tr Key=T396}" FontSize="17" FontAttributes="Bold" />
                                <Label Text="{local:Tr Key=T412}" Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding PlanProgressPercentText}" TextColor="{StaticResource PrimaryDark}" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                            <Border Style="{StaticResource MetricCard}">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{local:Tr Key=T397}" Style="{StaticResource MetricCaption}" />
                                    <Label Text="{Binding PlanExpectedIncomeText}" TextColor="#137A53" FontSize="20" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{local:Tr Key=T399}" Style="{StaticResource MetricCaption}" />
                                    <Label Text="{Binding PlanSavingsTargetText}" TextColor="#075985" FontSize="20" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource MetricCard}">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{local:Tr Key=T398}" Style="{StaticResource MetricCaption}" />
                                    <Label Text="{Binding PlanSpendingLimitText}" TextColor="#C2413A" FontSize="20" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricCard}">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{local:Tr Key=T108}" Style="{StaticResource MetricCaption}" />
                                    <Label Text="{Binding PlanActualIncomeText}" TextColor="#137A53" FontSize="20" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                        <ProgressBar Progress="{Binding PlanSpendingProgress}" ProgressColor="#E27852" BackgroundColor="#E7EDEA" HeightRequest="8" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{local:Tr Key=T514}" FontSize="17" FontAttributes="Bold" />
                            <Button Text="{local:Tr Key=T515}" FontSize="11" Style="{StaticResource SmallButton}" Clicked="OnClearMovementFilterClicked" IsVisible="{Binding HasMovementFilter}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,2" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{local:Tr Key=T516}" Style="{StaticResource MetricCaption}" />
                                <Picker ItemsSource="{Binding MovementFilterCategories}" SelectedItem="{Binding MovementCategoryFilter}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{local:Tr Key=T501}" Style="{StaticResource MetricCaption}" />
                                <DatePicker Date="{Binding MovementFilterFromDate}" Format="yyyy-MM-dd" />
                                <DatePicker Date="{Binding MovementFilterToDate}" Format="yyyy-MM-dd" Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{local:Tr Key=T519}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding MovementFilterDepositsText}" TextColor="#137A53" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{local:Tr Key=T520}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding MovementFilterSpendingText}" TextColor="#C2413A" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="3">
                                <Label Text="{local:Tr Key=T521}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding MovementFilterNetText}" TextColor="{Binding MovementFilterNetColor}" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{local:Tr Key=T549}" FontSize="17" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding DataQualityStatusText}" TextColor="{Binding DataQualityStatusColor}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{local:Tr Key=T550}" Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{local:Tr Key=T405}" FontSize="17" FontAttributes="Bold" />
                        <Entry Text="{Binding MovementSearchText}" Placeholder="{local:Tr Key=T406}" TextChanged="OnMovementSearchTextChanged" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding MovementSearchResults}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding TitleText}" FontAttributes="Bold" FontSize="14" />
                                            <Label Text="{Binding DetailText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                            <Label Text="{Binding DateText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                            <Label Text="{Binding AmountText}" TextColor="{Binding AmountColor}" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="End" />
                                            <Label Text="{Binding MovementTypeText}" Style="{StaticResource MutedLabel}" FontSize="12" HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="{local:Tr Key=T407}" Style="{StaticResource MutedLabel}" IsVisible="{Binding HasMovementSearchResults, Converter={x:Static local:InverseBooleanConverter.Instance}}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{local:Tr Key=T400}" FontSize="17" FontAttributes="Bold" />
                                <Label Text="{local:Tr Key=T411}" Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding UpcomingObligations}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14" />
                                            <Label Text="{Binding DueDate}" TextColor="{StaticResource PrimaryDark}" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" BackgroundColor="{Binding IsPaid, Converter={x:Static local:ObligationStatusConverter.Instance}}" WidthRequest="80" HeightRequest="26" StrokeThickness="0" VerticalOptions="Center">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                                            <Label Text="{Binding IsPaid, Converter={x:Static local:ObligationTextConverter.Instance}}" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{local:Tr Key=T155}" FontSize="17" FontAttributes="Bold" />
                                <Label Text="{Binding CurrentMonthHealthText}" TextColor="{Binding CurrentMonthHealthColor}" FontSize="13" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding CurrentMonthSpendingPercentText}" TextColor="{StaticResource PrimaryDark}" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                        <ProgressBar Progress="{Binding CurrentMonthSpendingProgress}" ProgressColor="#E27852" BackgroundColor="#E7EDEA" HeightRequest="8" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{local:Tr Key=T156}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding CurrentMonthSpendingPercentText}" FontAttributes="Bold" TextColor="#A84B2E" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{local:Tr Key=T157}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding CurrentMonthEntryCountText}" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{local:Tr Key=T446}" FontSize="17" FontAttributes="Bold" />
                                <Label Text="{local:Tr Key=T418}" Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                        <FlexLayout BindableLayout.ItemsSource="{Binding CategoryRegistryItems}" Wrap="Wrap" JustifyContent="SpaceBetween" Direction="Row" AlignItems="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,8,0" BackgroundColor="#F7F0E1" StrokeThickness="0" WidthRequest="140" HeightRequest="72">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                        <VerticalStackLayout Spacing="3" Padding="8" HorizontalOptions="Center" VerticalOptions="Center">
                                            <BoxView HeightRequest="8" WidthRequest="8" CornerRadius="4" Color="{Binding ColorHex}" HorizontalOptions="Center" />
                                            <Label Text="{Binding Category}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" MaxLines="2" />
                                            <Label Text="{Binding EntriesCountText}" FontSize="10" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{local:Tr Key=T181}" FontSize="17" FontAttributes="Bold" />
                                <Label Text="{Binding MonthlyBudgetStatusText}" TextColor="{Binding MonthlyBudgetStatusColor}" FontSize="13" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding MonthlyBudgetText}" TextColor="{StaticResource PrimaryDark}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                        <Entry Text="{Binding MonthlyBudgetInput}" Placeholder="{local:Tr Key=T181}" Keyboard="Numeric" />
                        <Button Text="{local:Tr Key=T186}" Clicked="OnSaveBudgetClicked" Style="{StaticResource SecondaryButton}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <ProgressBar Progress="{Binding MonthlyBudgetProgress}" ProgressColor="{Binding MonthlyBudgetStatusColor}" BackgroundColor="#E7EDEA" HeightRequest="8" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding MonthlyBudgetPercentText}" TextColor="{Binding MonthlyBudgetStatusColor}" FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{local:Tr Key=T389}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{local:Tr Key=T391}" Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding CurrentMonthExpensesText}" TextColor="#C2413A" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentMonthCategorySpending}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5">
                                        <Label Text="{Binding Category}" FontAttributes="Bold" />
                                        <Label Grid.Column="1" Text="{Binding AmountText}" TextColor="{StaticResource PrimaryDark}" FontAttributes="Bold" />
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Progress="{Binding Progress}" ProgressColor="{Binding AccentColor}" BackgroundColor="#E7EDEA" HeightRequest="7" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{local:Tr Key=T110}" FontSize="18" FontAttributes="Bold" />
                        <Label Text="{local:Tr Key=T115}" Style="{StaticResource MutedLabel}" />
                        <Button Text="{local:Tr Key=T110}" Clicked="OnAddClicked" Style="{StaticResource PrimaryButton}" HeightRequest="54" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto" Margin="2,6,2,0">
                    <Label Text="{local:Tr Key=T002}" FontSize="19" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="{Binding ReportCountText}" TextColor="{StaticResource PrimaryDark}" FontSize="14" VerticalOptions="Center" />
                </Grid>

                <CollectionView ItemsSource="{Binding RecentEntries}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Border Style="{StaticResource EmptyStateBorder}">
                            <Label Text="{local:Tr Key=T078}" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ListItemBorder}" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border BackgroundColor="#EAF8F2" WidthRequest="42" HeightRequest="42" StrokeThickness="0">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                        <Label Text="{local:Tr Key=T085}" TextColor="#087A55" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="{Binding MovementTypeText}" FontAttributes="Bold" />
                                        <Label Text="{Binding DateText}" Style="{StaticResource MutedLabel}" />
                                        <Label Text="{Binding NotesText}" Style="{StaticResource MutedLabel}" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding AmountText}" TextColor="{StaticResource PrimaryDark}" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
    </ScrollView>
</ContentPage>
