<ContentPage
    x:Class="Maen.Accounting.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Maen.Accounting.App"
    xmlns:views="clr-namespace:Maen.Accounting.App.Views"
    Title="{local:Tr Key=T032}">
    <RefreshView IsRefreshing="{Binding IsBusy, Mode=OneWay}" Refreshing="OnRefresh">
        <ScrollView>
            <VerticalStackLayout Padding="18,20,18,28" Spacing="18" MaximumWidthRequest="1100" HorizontalOptions="Center">
                <views:BrandHeaderView
                    Eyebrow="{local:Tr Key=T099}"
                    Title="{local:Tr Key=T092}"
                    Subtitle="{local:Tr Key=T094}"
                    Badge="{local:Tr Key=T097}"
                    HasBadge="True"
                    Status="{Binding SyncStatus}"
                    HasStatus="True" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#EAF8F2" Stroke="#B7EBD4" StrokeThickness="1" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="7"><Label Text="{local:Tr Key=T071}" Style="{StaticResource MutedLabel}"/><Label Text="{Binding CurrentMonthNetText}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}"/></VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#EFF6FF" Stroke="#BFDBFE" StrokeThickness="1" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="7"><Label Text="{local:Tr Key=T086}" Style="{StaticResource MutedLabel}"/><Label Text="{Binding CurrentMonthSalesText}" FontSize="22" FontAttributes="Bold" TextColor="#1D4ED8"/></VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#FFF7ED" Stroke="#FED7AA" StrokeThickness="1" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="7"><Label Text="{local:Tr Key=T070}" Style="{StaticResource MutedLabel}"/><Label Text="{Binding CurrentYearNetText}" FontSize="22" FontAttributes="Bold" TextColor="#C2410C"/></VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#FFF1F2" Stroke="#FECDD3" StrokeThickness="1" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="7"><Label Text="{local:Tr Key=T008}" Style="{StaticResource MutedLabel}"/><Label Text="{Binding TotalExpensesText}" FontSize="22" FontAttributes="Bold" TextColor="#BE123C"/></VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0" BackgroundColor="#F5F3FF" Stroke="#DDD6FE" StrokeThickness="1" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="7"><Label Text="{local:Tr Key=T034}" Style="{StaticResource MutedLabel}"/><Label Text="{Binding CurrentMonthGrossText}" FontSize="22" FontAttributes="Bold" TextColor="#6D28D9"/></VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BackgroundColor="#F0FDFA" Stroke="#99F6E4" StrokeThickness="1" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="7"><Label Text="{local:Tr Key=T088}" Style="{StaticResource MutedLabel}"/><Label Text="{Binding CurrentMonthAverageNetText}" FontSize="22" FontAttributes="Bold" TextColor="#0F766E"/></VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding HasFinancialPosition, Mode=OneWay}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{local:Tr Key=T413}" Style="{StaticResource SectionTitle}" />
                                <Label Text="{local:Tr Key=T068}" Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#EFF6FF" Padding="10,6" StrokeThickness="0" VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Label Text="{local:Tr Key=T097}" TextColor="#1D4ED8" FontSize="12" FontAttributes="Bold" />
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#F0FDFA" Padding="12" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <VerticalStackLayout Spacing="3"><Label Text="{local:Tr Key=T414}" Style="{StaticResource MetricCaption}"/><Label Text="{Binding ReceivableNetText}" TextColor="#0F766E" FontAttributes="Bold" FontSize="19"/></VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#FFF7ED" Padding="12" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <VerticalStackLayout Spacing="3"><Label Text="{local:Tr Key=T415}" Style="{StaticResource MetricCaption}"/><Label Text="{Binding PayableNetText}" TextColor="#C2410C" FontAttributes="Bold" FontSize="19"/></VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" BackgroundColor="#F5F3FF" Padding="12" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <VerticalStackLayout Spacing="3"><Label Text="{local:Tr Key=T416}" Style="{StaticResource MetricCaption}"/><Label Text="{Binding NetPositionText}" TextColor="{Binding NetPositionColor}" FontAttributes="Bold" FontSize="19"/></VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#FFF1F2" Padding="12" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <VerticalStackLayout Spacing="3"><Label Text="{local:Tr Key=T417}" Style="{StaticResource MetricCaption}"/><Label Text="{Binding OverdueSalesText}" TextColor="#BE123C" FontAttributes="Bold" FontSize="19"/></VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#F0F9FF" Padding="12" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <VerticalStackLayout Spacing="3"><Label Text="{local:Tr Key=T418}" Style="{StaticResource MetricCaption}"/><Label Text="{Binding OverduePurchasesText}" TextColor="#075985" FontAttributes="Bold" FontSize="19"/></VerticalStackLayout>
                            </Border>
                        </Grid>
                        <Button Text="{local:Tr Key=T480}" IsVisible="{Binding HasOverdueInvoices, Mode=OneWay}" Clicked="OnToggleOverdueClicked" Style="{StaticResource SecondaryButton}" />
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsOverdueExpanded, Mode=OneWay}">
                            <CollectionView ItemsSource="{Binding OverdueSalesInvoices}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="#FFF1F2" Stroke="#FECDD3" StrokeThickness="1" Padding="12" Margin="0,0,0,4">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="{Binding Number}" FontAttributes="Bold" TextColor="#BE123C"/>
                                                    <Label Text="{Binding ContactText}" Style="{StaticResource MutedLabel}" FontSize="12"/>
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" Text="{Binding AmountText}" TextColor="#BE123C" FontAttributes="Bold" VerticalOptions="Center"/>
                                                <Label Grid.Column="2" Text="{Binding AgeText}" Style="{StaticResource MutedLabel}" FontSize="12" VerticalOptions="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <CollectionView ItemsSource="{Binding OverduePurchasesInvoices}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="#F0F9FF" Stroke="#BAE6FD" StrokeThickness="1" Padding="12" Margin="0,0,0,4">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="{Binding Number}" FontAttributes="Bold" TextColor="#075985"/>
                                                    <Label Text="{Binding ContactText}" Style="{StaticResource MutedLabel}" FontSize="12"/>
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" Text="{Binding AmountText}" TextColor="#075985" FontAttributes="Bold" VerticalOptions="Center"/>
                                                <Label Grid.Column="2" Text="{Binding AgeText}" Style="{StaticResource MutedLabel}" FontSize="12" VerticalOptions="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{local:Tr Key=T090}" Style="{StaticResource SectionTitle}" />
                                <Label Text="{local:Tr Key=T067}" Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#EAF8F2" Padding="10,6" StrokeThickness="0" VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Label Text="{local:Tr Key=T097}" TextColor="#087A55" FontSize="12" FontAttributes="Bold" />
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#F5F3FF" Padding="12" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <VerticalStackLayout Spacing="3"><Label Text="{local:Tr Key=T026}" Style="{StaticResource MetricCaption}"/><Label Text="{Binding AccountingAccountsText}" TextColor="#6D28D9" FontAttributes="Bold" FontSize="19"/></VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#EFF6FF" Padding="12" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <VerticalStackLayout Spacing="3"><Label Text="{local:Tr Key=T042}" Style="{StaticResource MetricCaption}"/><Label Text="{Binding PostedJournalCountText}" TextColor="#1D4ED8" FontAttributes="Bold" FontSize="19"/></VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#FFF7ED" Padding="12" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <VerticalStackLayout Spacing="3"><Label Text="{local:Tr Key=T004}" Style="{StaticResource MetricCaption}"/><Label Text="{Binding PostedInvoiceTotalText}" TextColor="#C2410C" FontAttributes="Bold" FontSize="19"/></VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#F0FDFA" Padding="12" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <VerticalStackLayout Spacing="3"><Label Text="{local:Tr Key=T006}" Style="{StaticResource MetricCaption}"/><Label Text="{Binding PaymentsTotalText}" TextColor="#0F766E" FontAttributes="Bold" FontSize="19"/></VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button Text="{local:Tr Key=T010}" Clicked="OnAddClicked" Style="{StaticResource PrimaryButton}" HeightRequest="54" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="{local:Tr Key=T002}" Style="{StaticResource SectionTitle}" />
                        <Label Text="{local:Tr Key=T094}" Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" BackgroundColor="{StaticResource PrimaryLight}" Padding="12,8" StrokeThickness="0" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Label Text="{local:Tr Key=T097}" TextColor="{StaticResource PrimaryDark}" FontSize="12" FontAttributes="Bold" />
                    </Border>
                </Grid>

                <CollectionView ItemsSource="{Binding RecentEntries}" EmptyView="{local:Tr Key=T078}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="16">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
                                    <Label Text="{Binding DateText}" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding NetText}" FontSize="19" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding NotesText}" Style="{StaticResource MutedLabel}" LineBreakMode="TailTruncation" Margin="0,5,0,0" />
                                    <Button Grid.Row="2" Grid.ColumnSpan="2" Text="{local:Tr Key=T058}" Style="{StaticResource SecondaryButton}" CommandParameter="{Binding .}" Clicked="OnEditClicked" Margin="0,10,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
