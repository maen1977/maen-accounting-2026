<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Maen.Accounting.App.Views.BusinessPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="العمليات">
    <Grid RowDefinitions="Auto,*" Padding="18" MaximumWidthRequest="1100" HorizontalOptions="Center">
        <VerticalStackLayout Spacing="7">
            <Label Text="العمليات التجارية" Style="{StaticResource TitleLabel}" />
            <Label Text="العملاء والموردون والفواتير والمدفوعات" Style="{StaticResource MutedLabel}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Button Grid.Column="1" Text="تحديث" Style="{StaticResource SecondaryButton}" Clicked="OnRefreshClicked" />
            </Grid>
            <Label Text="{Binding StatusMessage}" Style="{StaticResource MutedLabel}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" Margin="0,14,0,0">
            <VerticalStackLayout Spacing="12">
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="عميل أو مورد جديد" FontSize="18" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Picker Title="النوع" ItemsSource="{Binding ContactTypes}" SelectedItem="{Binding SelectedContactType}" ItemDisplayBinding="{Binding Label}" />
                            <Entry Grid.Column="1" Text="{Binding ContactNameInput}" Placeholder="الاسم" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Text="{Binding ContactPhoneInput}" Placeholder="الهاتف" Keyboard="Telephone" />
                            <Button Grid.Column="1" Text="حفظ" Style="{StaticResource PrimaryButton}" Clicked="OnSaveContactClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <CollectionView ItemsSource="{Binding Contacts}" HeightRequest="180" EmptyView="لا يوجد عملاء أو موردون.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,7">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                                        <Label Text="{Binding Phone}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding TypeText}" TextColor="{StaticResource PrimaryDark}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="فاتورة جديدة" FontSize="18" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Picker Title="نوع الفاتورة" ItemsSource="{Binding InvoiceTypes}" SelectedItem="{Binding SelectedInvoiceType}" ItemDisplayBinding="{Binding Label}" />
                            <Picker Grid.Column="1" Title="العميل أو المورد" ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedInvoiceContact}" ItemDisplayBinding="{Binding DisplayText}" />
                        </Grid>
                        <DatePicker Date="{Binding InvoiceDate}" Format="yyyy-MM-dd" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Entry Text="{Binding InvoiceNumberInput}" Placeholder="رقم الفاتورة" />
                            <Entry Grid.Column="1" Text="{Binding InvoiceAmountInput}" Placeholder="المبلغ" Keyboard="Numeric" />
                            <Entry Grid.Column="2" Text="{Binding InvoiceTaxInput}" Placeholder="الضريبة" Keyboard="Numeric" />
                        </Grid>
                        <Entry Text="{Binding InvoiceDescriptionInput}" Placeholder="وصف الفاتورة" />
                        <Button Text="حفظ وترحيل الفاتورة" Style="{StaticResource PrimaryButton}" Clicked="OnSaveInvoiceClicked" />
                    </VerticalStackLayout>
                </Border>
                <CollectionView ItemsSource="{Binding Invoices}" HeightRequest="230" EmptyView="لا توجد فواتير.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,7">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Number}" FontAttributes="Bold" />
                                        <Label Text="{Binding ContactText, StringFormat='{0} — {1}'}" Style="{StaticResource MutedLabel}" />
                                        <Label Text="{Binding DateText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                        <Label Text="{Binding TotalText}" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                                        <Label Text="{Binding TypeText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="دفعة أو قبض جديد" FontSize="18" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Picker Title="نوع العملية" ItemsSource="{Binding PaymentTypes}" SelectedItem="{Binding SelectedPaymentType}" ItemDisplayBinding="{Binding Label}" />
                            <Picker Grid.Column="1" Title="العميل أو المورد" ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedPaymentContact}" ItemDisplayBinding="{Binding DisplayText}" />
                        </Grid>
                        <DatePicker Date="{Binding PaymentDate}" Format="yyyy-MM-dd" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Entry Text="{Binding PaymentNumberInput}" Placeholder="رقم العملية" />
                            <Entry Grid.Column="1" Text="{Binding PaymentAmountInput}" Placeholder="المبلغ" Keyboard="Numeric" />
                        </Grid>
                        <Button Text="حفظ وترحيل العملية" Style="{StaticResource PrimaryButton}" Clicked="OnSavePaymentClicked" />
                    </VerticalStackLayout>
                </Border>
                <CollectionView ItemsSource="{Binding Payments}" HeightRequest="190" EmptyView="لا توجد مدفوعات.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,7">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Number}" FontAttributes="Bold" />
                                        <Label Text="{Binding ContactText}" Style="{StaticResource MutedLabel}" />
                                        <Label Text="{Binding DateText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                        <Label Text="{Binding AmountText}" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                                        <Label Text="{Binding TypeText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
