<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Maen.Accounting.App.Views.BusinessPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Maen.Accounting.App"
    Title="{local:Tr Key=T039}">
    <Grid RowDefinitions="Auto,*" Padding="18" MaximumWidthRequest="1100" HorizontalOptions="Center">
        <VerticalStackLayout Spacing="7">
            <Label Text="{local:Tr Key=T040}" Style="{StaticResource TitleLabel}" />
            <Label Text="{local:Tr Key=T038}" Style="{StaticResource MutedLabel}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Button Grid.Column="1" Text="{local:Tr Key=T052}" Style="{StaticResource SecondaryButton}" Clicked="OnRefreshClicked" />
            </Grid>
            <Label Text="{Binding StatusMessage}" Style="{StaticResource MutedLabel}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" Margin="0,14,0,0">
            <VerticalStackLayout Spacing="12">
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{local:Tr Key=T073}" FontSize="18" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Picker Title="{local:Tr Key=T050}" ItemsSource="{Binding ContactTypes}" SelectedItem="{Binding SelectedContactType}" ItemDisplayBinding="{Binding Label}" />
                            <Entry Grid.Column="1" Text="{Binding ContactNameInput}" Placeholder="{local:Tr Key=T299}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Text="{Binding ContactPhoneInput}" Placeholder="{local:Tr Key=T300}" Keyboard="Telephone" />
                            <Button Grid.Column="1" Text="{local:Tr Key=T062}" Style="{StaticResource PrimaryButton}" Clicked="OnSaveContactClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <CollectionView ItemsSource="{Binding Contacts}" HeightRequest="180" EmptyView="{local:Tr Key=T084}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,7">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                                        <Label Text="{Binding Phone}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding TypeText}" TextColor="{StaticResource PrimaryDark}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{local:Tr Key=T074}" FontSize="18" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Picker Title="{local:Tr Key=T101}" ItemsSource="{Binding InvoiceTypes}" SelectedItem="{Binding SelectedInvoiceType}" ItemDisplayBinding="{Binding Label}" />
                            <Picker Grid.Column="1" Title="{local:Tr Key=T041}" ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedInvoiceContact}" ItemDisplayBinding="{Binding DisplayText}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{local:Tr Key=T021}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                <DatePicker Date="{Binding InvoiceDate}" Format="yyyy-MM-dd" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{local:Tr Key=T358}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                <DatePicker Date="{Binding InvoiceDueDate}" Format="yyyy-MM-dd" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Entry Text="{Binding InvoiceNumberInput}" Placeholder="{local:Tr Key=T301}" />
                            <Entry Grid.Column="1" Text="{Binding InvoiceAmountInput}" Placeholder="{local:Tr Key=T297}" Keyboard="Numeric" />
                            <Entry Grid.Column="2" Text="{Binding InvoiceTaxInput}" Placeholder="{local:Tr Key=T302}" Keyboard="Numeric" />
                        </Grid>
                        <Entry Text="{Binding InvoiceDescriptionInput}" Placeholder="{local:Tr Key=T303}" />
                        <Button Text="{local:Tr Key=T064}" Style="{StaticResource PrimaryButton}" Clicked="OnSaveInvoiceClicked" />
                    </VerticalStackLayout>
                </Border>
                <CollectionView ItemsSource="{Binding Invoices}" HeightRequest="230" EmptyView="{local:Tr Key=T080}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,7">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Number}" FontAttributes="Bold" />
                                        <Label Text="{Binding ContactText, StringFormat='{0} — {1}'}" Style="{StaticResource MutedLabel}" />
                                        <Label Text="{Binding DateText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                        <Label Text="{Binding DueDateText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                        <Label Text="{Binding TotalText}" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                                        <Label Text="{Binding TypeText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{local:Tr Key=T065}" FontSize="18" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Picker Title="{local:Tr Key=T100}" ItemsSource="{Binding PaymentTypes}" SelectedItem="{Binding SelectedPaymentType}" ItemDisplayBinding="{Binding Label}" />
                            <Picker Grid.Column="1" Title="{local:Tr Key=T041}" ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedPaymentContact}" ItemDisplayBinding="{Binding DisplayText}" />
                        </Grid>
                        <Picker Title="{local:Tr Key=T373}" ItemsSource="{Binding PaymentAccounts}" SelectedItem="{Binding SelectedPaymentAccount}" ItemDisplayBinding="{Binding DisplayText}" />
                        <DatePicker Date="{Binding PaymentDate}" Format="yyyy-MM-dd" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Entry Text="{Binding PaymentNumberInput}" Placeholder="{local:Tr Key=T304}" />
                            <Entry Grid.Column="1" Text="{Binding PaymentAmountInput}" Placeholder="{local:Tr Key=T297}" Keyboard="Numeric" />
                        </Grid>
                        <Button Text="{local:Tr Key=T063}" Style="{StaticResource PrimaryButton}" Clicked="OnSavePaymentClicked" />
                    </VerticalStackLayout>
                </Border>
                <CollectionView ItemsSource="{Binding Payments}" HeightRequest="190" EmptyView="{local:Tr Key=T082}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,7">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Number}" FontAttributes="Bold" />
                                        <Label Text="{Binding ContactText}" Style="{StaticResource MutedLabel}" />
                                        <Label Text="{Binding AccountText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                        <Label Text="{Binding DateText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                        <Label Text="{Binding AmountText}" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                                        <Label Text="{Binding TypeText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
