<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Maen.Accounting.App.Views.AccountingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="المحاسبة">
    <Grid RowDefinitions="Auto,Auto,*" Padding="18" MaximumWidthRequest="1100" HorizontalOptions="Center">
        <VerticalStackLayout Spacing="8">
            <Label Text="مركز المحاسبة" Style="{StaticResource TitleLabel}" />
            <Label Text="دليل الحسابات وميزان المراجعة والقيود المرحّلة" Style="{StaticResource MutedLabel}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                <Button Text="تحديث" Style="{StaticResource SecondaryButton}" Clicked="OnRefreshClicked" />
                <Button Grid.Column="1" Text="ترحيل السجلات القديمة" Style="{StaticResource PrimaryButton}" Clicked="OnMigrateClicked" />
            </Grid>
            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{StaticResource PrimaryDark}" />
            <Label Text="{Binding StatusMessage}" Style="{StaticResource MutedLabel}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,14,0,0">
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout>
                    <Label Text="إجمالي المدين" Style="{StaticResource MutedLabel}" />
                    <Label Text="{Binding TotalDebitText}" FontSize="18" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <VerticalStackLayout>
                    <Label Text="إجمالي الدائن" Style="{StaticResource MutedLabel}" />
                    <Label Text="{Binding TotalCreditText}" FontSize="18" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <VerticalStackLayout>
                    <Label Text="حالة الميزان" Style="{StaticResource MutedLabel}" />
                    <Label Text="{Binding BalanceStatusText}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <ScrollView Grid.Row="2" Margin="0,14,0,0">
            <VerticalStackLayout Spacing="10">
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="قيد يومية جديد" FontSize="18" FontAttributes="Bold" />
                        <DatePicker Date="{Binding JournalDate}" Format="yyyy-MM-dd" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Picker Title="الحساب المدين" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedDebitAccount}" ItemDisplayBinding="{Binding DisplayText}" />
                            <Picker Grid.Column="1" Title="الحساب الدائن" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedCreditAccount}" ItemDisplayBinding="{Binding DisplayText}" />
                        </Grid>
                        <Entry Text="{Binding JournalAmountInput}" Keyboard="Numeric" Placeholder="المبلغ" />
                        <Entry Text="{Binding JournalDescription}" Placeholder="بيان القيد" />
                        <Button Text="ترحيل القيد" Style="{StaticResource PrimaryButton}" Clicked="OnSaveJournalClicked" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="دليل الحسابات" FontSize="18" FontAttributes="Bold" />
                <CollectionView ItemsSource="{Binding Accounts}" HeightRequest="300" EmptyView="لا توجد حسابات.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Code}" FontAttributes="Bold" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                                        <Label Text="{Binding TypeText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="نشط" TextColor="{StaticResource PrimaryDark}" FontSize="12" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                    <Label Text="ميزان المراجعة" FontSize="18" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="{Binding PostedEntriesText, StringFormat='قيود مرحّلة: {0}'}" Style="{StaticResource MutedLabel}" />
                </Grid>
                <CollectionView ItemsSource="{Binding TrialBalanceRows}" HeightRequest="330" EmptyView="لا توجد قيود مرحّلة بعد.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="55,*,Auto,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Code}" FontAttributes="Bold" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                                        <Label Text="{Binding NatureText, StringFormat='الرصيد: {0}'}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding DebitText, StringFormat='مدين {0}'}" FontSize="12" />
                                    <Label Grid.Column="3" Text="{Binding CreditText, StringFormat='دائن {0}'}" FontSize="12" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
