<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Maen.Accounting.App.Views.AccountingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Maen.Accounting.App"
    Title="{local:Tr Key=T044}">
    <Grid RowDefinitions="Auto,Auto,*" Padding="18" MaximumWidthRequest="1100" HorizontalOptions="Center">
        <VerticalStackLayout Spacing="8">
            <Label Text="{local:Tr Key=T090}" Style="{StaticResource TitleLabel}" />
            <Label Text="{local:Tr Key=T067}" Style="{StaticResource MutedLabel}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                <Button Text="{local:Tr Key=T052}" Style="{StaticResource SecondaryButton}" Clicked="OnRefreshClicked" />
                <Button Grid.Column="1" Text="{local:Tr Key=T053}" Style="{StaticResource PrimaryButton}" Clicked="OnMigrateClicked" />
            </Grid>
            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{StaticResource PrimaryDark}" />
            <Label Text="{Binding StatusMessage}" Style="{StaticResource MutedLabel}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,14,0,0">
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout>
                    <Label Text="{local:Tr Key=T007}" Style="{StaticResource MutedLabel}" />
                    <Label Text="{Binding TotalDebitText}" FontSize="18" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <VerticalStackLayout>
                    <Label Text="{local:Tr Key=T003}" Style="{StaticResource MutedLabel}" />
                    <Label Text="{Binding TotalCreditText}" FontSize="18" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <VerticalStackLayout>
                    <Label Text="{local:Tr Key=T060}" Style="{StaticResource MutedLabel}" />
                    <Label Text="{Binding BalanceStatusText}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <ScrollView Grid.Row="2" Margin="0,14,0,0">
            <VerticalStackLayout Spacing="10">
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                                                    <Label Text="{Binding JournalFormTitle}" FontSize="18" FontAttributes="Bold" />

                        <DatePicker Date="{Binding JournalDate}" Format="yyyy-MM-dd" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Picker Title="{local:Tr Key=T025}" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedDebitAccount}" ItemDisplayBinding="{Binding DisplayText}" />
                            <Picker Grid.Column="1" Title="{local:Tr Key=T024}" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedCreditAccount}" ItemDisplayBinding="{Binding DisplayText}" />
                        </Grid>
                        <Entry Text="{Binding JournalAmountInput}" Keyboard="Numeric" Placeholder="{local:Tr Key=T297}" />
                        <Entry Text="{Binding JournalDescription}" Placeholder="{local:Tr Key=T298}" />
                        <Button Text="{Binding JournalSaveButtonText}" Style="{StaticResource PrimaryButton}" Clicked="OnSaveJournalClicked" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding AccountFormTitle}" FontSize="18" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Entry Text="{Binding AccountCodeInput}" Placeholder="{local:Tr Key=T855}" />
                            <Entry Grid.Column="1" Text="{Binding AccountNameInput}" Placeholder="{local:Tr Key=T856}" />
                        </Grid>
                        <Picker Title="{local:Tr Key=T050}" ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding SelectedAccountType}" ItemDisplayBinding="{Binding Label}" />
                        <Button Text="{Binding AccountSaveButtonText}" Style="{StaticResource AccentButton}" Clicked="OnSaveAccountClicked" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{local:Tr Key=T066}" FontSize="18" FontAttributes="Bold" />
                <CollectionView ItemsSource="{Binding Accounts}" HeightRequest="360" EmptyView="{local:Tr Key=T077}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="70,*,Auto" ColumnSpacing="8" RowSpacing="8">
                                    <Label Text="{Binding Code}" FontAttributes="Bold" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                                        <Label Text="{Binding TypeText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{local:Tr Key=T097}" TextColor="{StaticResource PrimaryDark}" FontSize="12" />
                                    <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="3" Spacing="8" IsVisible="{Binding IsUserManaged}">
                                        <Button Text="{local:Tr Key=T488}" Style="{StaticResource SmallButton}" FontSize="11" Clicked="OnEditAccountClicked" CommandParameter="{Binding .}" />
                                        <Button Text="{local:Tr Key=T490}" Style="{StaticResource DangerButton}" FontSize="11" Clicked="OnDeleteAccountClicked" CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{local:Tr Key=T854}" FontSize="18" FontAttributes="Bold" />
                <CollectionView ItemsSource="{Binding JournalEntries}" HeightRequest="420" EmptyView="{local:Tr Key=T857}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding EntryNumber}" FontAttributes="Bold" />
                                            <Label Text="{Binding Description}" Style="{StaticResource MutedLabel}" />
                                            <Label Text="{Binding DateText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding SourceText}" TextColor="{StaticResource PrimaryDark}" FontSize="12" VerticalOptions="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Label Text="{Binding DebitText}" FontAttributes="Bold" />
                                        <Label Grid.Column="1" Text="{Binding CreditText}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsEditable}">
                                        <Button Text="{local:Tr Key=T488}" Style="{StaticResource SecondaryButton}" Clicked="OnEditJournalEntryClicked" CommandParameter="{Binding .}" />
                                        <Button Grid.Column="1" Text="{local:Tr Key=T490}" Style="{StaticResource DangerButton}" Clicked="OnDeleteJournalEntryClicked" CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                    <Label Text="{local:Tr Key=T095}" FontSize="18" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="{Binding PostedEntriesSummaryText}" Style="{StaticResource MutedLabel}" />
                </Grid>
                <CollectionView ItemsSource="{Binding TrialBalanceRows}" HeightRequest="330" EmptyView="{local:Tr Key=T081}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="55,*,Auto,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Code}" FontAttributes="Bold" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                                        <Label Text="{Binding BalanceSummaryText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding DebitSummaryText}" FontSize="12" />
                                    <Label Grid.Column="3" Text="{Binding CreditSummaryText}" FontSize="12" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
