<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Maen.Accounting.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="الدخول">
    <ScrollView>
        <VerticalStackLayout Padding="24,48" Spacing="18" MaximumWidthRequest="560" HorizontalOptions="Center">
            <Image Source="maen_logo.png" WidthRequest="110" HeightRequest="110" />
            <Label Text="معن للمحاسبة" Style="{StaticResource TitleLabel}" HorizontalTextAlignment="Center" />
            <Label Text="سجلات مالية يومية دقيقة مع فصل كامل بين الحسابات" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />

            <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                <VerticalStackLayout Spacing="12">
                    <Label Text="البريد الإلكتروني" FontAttributes="Bold" />
                    <Entry x:Name="EmailEntry" Keyboard="Email" Placeholder="name@example.com" FlowDirection="LeftToRight" />
                    <Label Text="كلمة المرور" FontAttributes="Bold" />
                    <Entry x:Name="PasswordEntry" IsPassword="True" Placeholder="6 أحرف على الأقل" FlowDirection="LeftToRight" />
                    <Label x:Name="ConfirmLabel" Text="تأكيد كلمة المرور" FontAttributes="Bold" IsVisible="False" />
                    <Entry x:Name="ConfirmEntry" IsPassword="True" Placeholder="أعد كتابة كلمة المرور" IsVisible="False" FlowDirection="LeftToRight" />
                    <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" IsRunning="False" Color="{StaticResource Primary}" />
                    <Label x:Name="StatusLabel" TextColor="{StaticResource Danger}" />
                    <Button x:Name="SubmitButton" Text="تسجيل الدخول" Clicked="OnSubmitClicked" />
                    <Button x:Name="ModeButton" Text="إنشاء حساب جديد" Style="{StaticResource SecondaryButton}" Clicked="OnModeClicked" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="استخدام محلي" Style="{StaticResource SectionTitle}" />
                    <Label Text="يعمل دون سحابة، وتبقى بيانات هذا البريد داخل الجهاز فقط." Style="{StaticResource MutedLabel}" />
                    <Button Text="فتح بوضع محلي" Style="{StaticResource SecondaryButton}" Clicked="OnLocalClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
