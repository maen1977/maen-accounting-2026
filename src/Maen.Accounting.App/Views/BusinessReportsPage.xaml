<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Maen.Accounting.App.Views.BusinessReportsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Maen.Accounting.App"
    xmlns:views="clr-namespace:Maen.Accounting.App.Views">
    <Grid RowDefinitions="Auto,*" Padding="18" MaximumWidthRequest="1100" HorizontalOptions="Center">
        <views:BrandHeaderView
            Eyebrow="Maen Accounting"
            Title="{local:Tr Key=T503}"
            Subtitle="{local:Tr Key=T038}"
            Status="{Binding StatusMessage}"
            HasStatus="True" />

        <ScrollView Grid.Row="1" Margin="0,14,0,0">
            <VerticalStackLayout Spacing="14">
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{local:Tr Key=T539}" Style="{StaticResource SectionTitle}" />
                            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{local:Tr Key=T501}" Style="{StaticResource MetricCaption}" />
                                <DatePicker Date="{Binding FromDate}" Format="yyyy-MM" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{local:Tr Key=T502}" Style="{StaticResource MetricCaption}" />
                                <DatePicker Date="{Binding ToDate}" Format="yyyy-MM" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="{local:Tr Key=T537}" FontSize="11" Style="{StaticResource SmallButton}" VerticalOptions="End" Clicked="OnExportCsvClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Style="{StaticResource MetricCard}">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{local:Tr Key=T509}" Style="{StaticResource MetricCaption}" />
                            <Label Text="{Binding BestMonthText}" TextColor="#137A53" FontSize="18" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{local:Tr Key=T540}" Style="{StaticResource MetricCaption}" />
                            <Label Text="{Binding WorstMonthText}" TextColor="#C2413A" FontSize="18" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{local:Tr Key=T504}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding TotalSalesText}" TextColor="#137A53" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{local:Tr Key=T505}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding TotalPurchasesText}" TextColor="#C2413A" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="3">
                                <Label Text="{local:Tr Key=T506}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding TotalReceiptsText}" TextColor="#137A53" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="3" Spacing="3">
                                <Label Text="{local:Tr Key=T507}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding TotalSupplierPaymentsText}" TextColor="#C2413A" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding HasAgingExposure}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{local:Tr Key=T544}" Style="{StaticResource SectionTitle}" />
                        <Label Text="{local:Tr Key=T545}" Style="{StaticResource MutedLabel}" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{local:Tr Key=T546}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding ReceivablesAgingCurrentText}" TextColor="#137A53" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{local:Tr Key=T547}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding ReceivablesAgingDaysOverNinetyText}" TextColor="#C2413A" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="3">
                                <Label Text="{local:Tr Key=T548}" Style="{StaticResource MetricCaption}" />
                                <Label Text="{Binding PayablesAgingTotalText}" TextColor="#A84B2E" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{local:Tr Key=T503}" Style="{StaticResource SectionTitle}" />
                <CollectionView ItemsSource="{Binding MonthlySlices}" HeightRequest="420" EmptyView="{local:Tr Key=T080}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ListItemBorder}" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Label Text="{Binding MonthText}" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Grid Grid.Column="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{local:Tr Key=T532}" Style="{StaticResource MutedLabel}" FontSize="11" />
                                            <Label Text="{Binding SalesText}" FontSize="13" FontAttributes="Bold" TextColor="#137A53" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{local:Tr Key=T533}" Style="{StaticResource MutedLabel}" FontSize="11" />
                                            <Label Text="{Binding PurchasesText}" FontSize="13" FontAttributes="Bold" TextColor="#C2413A" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                                            <Label Text="{local:Tr Key=T536}" Style="{StaticResource MutedLabel}" FontSize="11" />
                                            <Label Text="{Binding NetCashText}" FontSize="13" FontAttributes="Bold" TextColor="{Binding NetCashColor}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Label Grid.Column="2" Text="{Binding NetCashText}" TextColor="{Binding NetCashColor}" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
