<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Maen.Accounting.App.Views.BusinessInvoicesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Maen.Accounting.App"
    xmlns:views="clr-namespace:Maen.Accounting.App.Views">
    <Grid RowDefinitions="Auto,*" Padding="18" MaximumWidthRequest="1100" HorizontalOptions="Center">
        <views:BrandHeaderView
            Eyebrow="Maen Accounting"
            Title="{local:Tr Key=T074}"
            Subtitle="{local:Tr Key=T038}"
            Status="{Binding StatusMessage}"
            HasStatus="True" />

        <ScrollView Grid.Row="1" Margin="0,14,0,0">
            <VerticalStackLayout Spacing="14">
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{local:Tr Key=T074}" Style="{StaticResource SectionTitle}" />
                            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Picker Title="{local:Tr Key=T101}" ItemsSource="{Binding InvoiceTypes}" SelectedItem="{Binding SelectedInvoiceType}" ItemDisplayBinding="{Binding Label}" />
                            <Picker Grid.Column="1" Title="{local:Tr Key=T041}" ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedInvoiceContact}" ItemDisplayBinding="{Binding DisplayText}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{local:Tr Key=T021}" Style="{StaticResource MetricCaption}" />
                                <DatePicker Date="{Binding InvoiceDate}" Format="yyyy-MM-dd" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{local:Tr Key=T358}" Style="{StaticResource MetricCaption}" />
                                <DatePicker Date="{Binding InvoiceDueDate}" Format="yyyy-MM-dd" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Entry Text="{Binding InvoiceNumberInput}" Placeholder="{local:Tr Key=T301}" />
                            <Entry Grid.Column="1" Text="{Binding InvoiceAmountInput}" Placeholder="{local:Tr Key=T297}" Keyboard="Numeric" />
                            <Entry Grid.Column="2" Text="{Binding InvoiceTaxInput}" Placeholder="{local:Tr Key=T302}" Keyboard="Numeric" />
                        </Grid>
                        <Entry Text="{Binding InvoiceDescriptionInput}" Placeholder="{local:Tr Key=T303}" />
                        <Button Text="{local:Tr Key=T064}" Style="{StaticResource AccentButton}" Clicked="OnSaveInvoiceClicked" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{local:Tr Key=T074}" Style="{StaticResource SectionTitle}" />
                <CollectionView ItemsSource="{Binding Invoices}" HeightRequest="420" EmptyView="{local:Tr Key=T080}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ListItemBorder}" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding Number}" FontAttributes="Bold" />
                                        <Label Text="{Binding ContactText}" Style="{StaticResource MutedLabel}" />
                                        <Label Text="{Binding DateText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                        <Label Text="{Binding DueDateText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="3">
                                        <Label Text="{Binding TotalText}" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                                        <Label Text="{Binding TypeText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                        <Label Text="{Binding StatusText}" TextColor="{StaticResource Success}" FontSize="12" FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
